
[{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/arts/","section":"Arts","summary":"","title":"Arts","type":"arts"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/categories/arts/","section":"Categories","summary":"","title":"Arts","type":"categories"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/authors/","section":"Authors","summary":"","title":"Authors","type":"authors"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/categories/","section":"Categories","summary":"","title":"Categories","type":"categories"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/tags/","section":"Tags","summary":"","title":"Tags","type":"tags"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/","section":"Tori's Website","summary":"","title":"Tori's Website","type":"page"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/authors/zitian-zhu/","section":"Authors","summary":"","title":"Zitian Zhu","type":"authors"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/tags/%E5%9B%9E%E9%A1%BE/","section":"Tags","summary":"","title":"回顾","type":"tags"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/tags/%E5%B1%95%E8%A7%88/","section":"Tags","summary":"","title":"展览","type":"tags"},{"content":"","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/tags/%E6%91%84%E5%BD%B1/","section":"Tags","summary":"","title":"摄影","type":"tags"},{"content":"\r「破茧」摄影展回顾\r#\r这次摄影展的主题是 「破茧」。\n从一岁一枯荣的草木更替，到南半球地平线上一抹温柔的黄昏；从枝头小憩的宁静瞬间，到破土而出、绝处逢生的倔强——镜头一点点把我们带离日常，重新看见周遭那些常常被忽略的小世界。\n下面是这次展览中的作品回顾：\n一点感想\r#\r回头再看这一组作品，其实还带着点稚嫩的痕迹：构图未必都恰到好处，光线也有几处没能抓住最好的瞬间。但换个角度想，哪一次启程不是从这样的「做起来」开始的？\n不必等到万事俱备再动手。先举起相机，先按下快门，先把那些打动自己的瞬间收进来——哪怕粗糙，哪怕生涩。多走几步，多拍几次，自然就会慢慢知道：什么值得留在画面里，什么应该放掉。\n「破茧」不只是这组照片的名字，大概也是做任何一件事的样子：先做起来，再逐渐成熟。\n","date":"12 November 2026","externalUrl":null,"permalink":"/asadi/arts/photography-exhibition-review/","section":"Arts","summary":"","title":"摄影展回顾","type":"arts"},{"content":"","date":"8 November 2026","externalUrl":null,"permalink":"/asadi/tags/blowfish/","section":"Tags","summary":"","title":"Blowfish","type":"tags"},{"content":"","date":"8 November 2026","externalUrl":null,"permalink":"/asadi/tags/hugo/","section":"Tags","summary":"","title":"Hugo","type":"tags"},{"content":"","date":"8 November 2026","externalUrl":null,"permalink":"/asadi/posts/","section":"Posts","summary":"","title":"Posts","type":"posts"},{"content":"正文在这里，Markdown 正常写\n二级标题\r#\r内容内容内容\n","date":"8 November 2026","externalUrl":null,"permalink":"/asadi/posts/arts/expo-art-math/","section":"Posts","summary":"","title":"我的第一篇博客Expo Art Math","type":"posts"},{"content":"","externalUrl":null,"permalink":"/asadi/maths/","section":"Maths","summary":"","title":"Maths","type":"maths"},{"content":"\r测试一下\r#\r","externalUrl":null,"permalink":"/asadi/musics/","section":"Musics","summary":"","title":"Musics","type":"musics"},{"content":"","externalUrl":null,"permalink":"/asadi/series/","section":"Series","summary":"","title":"Series","type":"series"}]